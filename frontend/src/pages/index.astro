---
import '../styles/global.css';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>nsend // sender</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="min-h-screen bg-bg text-text antialiased relative overflow-x-hidden">

  <div class="min-h-screen flex flex-col items-center justify-center px-4 sm:px-6 md:px-8 py-12 sm:py-16">
    <div class="w-full max-w-2xl">
      <div class="text-center mb-10 sm:mb-12">
        <div class="inline-flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 border-2 border-border mb-6">
          <svg class="w-7 h-7 sm:w-8 sm:h-8 text-text" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M4 8h16M4 16h16M12 4l4 4-4 4M12 4L8 8l4 4" />
          </svg>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-text tracking-tight mb-4">NSEND<br class="sm:hidden" /> <span class="text-accent"></span></h1>
        <p class="text-sm sm:text-base md:text-lg text-text-muted max-w-md mx-auto leading-relaxed"></p>
      </div>

      <div class="border-2 border-border bg-surface p-6 sm:p-8 md:p-10 space-y-6">
        <div class="space-y-3">
          <label for="files" class="flex items-center gap-2.5 text-sm font-medium text-text-muted">
            <span class="text-accent">[+]</span>
            Select files
          </label>
          <input type="file" id="files" multiple aria-label="Select files to send" class="block w-full text-sm text-text-muted file:mr-3 file:py-2 file:px-4 file:border-2 file:border-border file:text-sm file:font-mono file:bg-surface file:text-text file:cursor-pointer cursor-pointer" />
          <div id="fileSummary" class="text-xs text-text-muted font-mono h-4"></div>
        </div>

        <button id="send" class="w-full inline-flex items-center justify-center gap-2.5 px-6 py-3.5 text-base font-bold text-bg bg-accent hover:bg-accent-hover border-2 border-border transition-colors" aria-label="Start file transfer">
          <span>START TRANSFER</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </button>

        <div id="progressArea" class="hidden space-y-2">
          <div class="w-full h-1.5 bg-surface border border-border">
            <div id="progressBar" class="h-full bg-accent transition-all duration-300" style="width: 0%"></div>
          </div>
          <div class="flex items-center justify-end">
            <span id="speed" class="text-[10px] text-text-dim font-mono"></span>
          </div>
          <button id="cancelBtn" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2 text-xs font-mono text-red border-2 border-border hover:bg-surface transition-colors" aria-label="Cancel transfer">
            [CANCEL]
          </button>
        </div>

        <div class="space-y-3 pt-1">
          <div id="status" role="status" aria-live="polite" class="text-sm text-amber h-5 font-mono"></div>
          <div id="link" class="text-sm break-all flex flex-col sm:flex-row sm:items-center gap-2"></div>
        </div>
      </div>

      <div class="mt-8 flex items-center justify-center gap-6 text-text-dim">
        <div class="flex items-center gap-2">
          <span class="text-xs font-mono">[E2E]</span>
          <span class="text-xs">Encrypted</span>
        </div>
        <div class="w-1 h-1 bg-border"></div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-mono">[INF]</span>
          <span class="text-xs">No limits</span>
        </div>
        <div class="w-1 h-1 bg-border hidden sm:block"></div>
        <div class="hidden sm:flex items-center gap-2">
          <span class="text-xs font-mono">[NOW]</span>
          <span class="text-xs">Instant</span>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { initSender } from '../lib/sender';
    initSender();
  </script>
</body>
</html>
