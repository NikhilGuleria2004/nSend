---
import '../styles/global.css';
import '../styles/themes.css';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>nsend // sender</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script is:inline>
    (function() {
      const saved = localStorage.getItem('nsend-theme');
      if (saved) {
        document.documentElement.setAttribute('data-theme', saved);
      }
    })();
  </script>
</head>
<body class="min-h-screen bg-bg text-text antialiased relative overflow-x-hidden">
  <div class="fixed top-0 left-0 right-0 z-50 bg-border">
    <div class="flex items-center justify-between px-4 py-2">
      <span class="text-xs font-mono text-bg">NSEND</span>
      <div class="flex gap-1">
        <button data-theme-btn="light" class="theme-btn px-2 py-1 text-xs font-mono bg-bg text-text border border-border hover:border-text transition-colors">LIGHT</button>
        <button data-theme-btn="dark" class="theme-btn px-2 py-1 text-xs font-mono bg-bg text-text border border-border hover:border-text transition-colors">DARK</button>
        <button data-theme-btn="cream" class="theme-btn px-2 py-1 text-xs font-mono bg-bg text-text border border-border hover:border-text transition-colors">CREAM</button>
        <button data-theme-btn="matrix" class="theme-btn px-2 py-1 text-xs font-mono bg-bg text-text border border-border hover:border-text transition-colors">MATRIX</button>
        <button data-theme-btn="amber" class="theme-btn px-2 py-1 text-xs font-mono bg-bg text-text border border-border hover:border-text transition-colors">AMBER</button>
        <button data-theme-btn="brutalist" class="theme-btn px-2 py-1 text-xs font-mono bg-bg text-text border border-border hover:border-text transition-colors">BRUTALIST</button>
      </div>
    </div>
  </div>

  <div class="min-h-screen flex flex-col items-center justify-center px-4 sm:px-6 md:px-8 py-12 sm:py-16 mt-8">
    <div class="w-full max-w-2xl">
      <div class="text-center mb-10 sm:mb-12">
        <div class="inline-flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 border-2 border-border mb-6">
          <svg class="w-7 h-7 sm:w-8 sm:h-8 text-text" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M4 8h16M4 16h16M12 4l4 4-4 4M12 4L8 8l4 4" />
          </svg>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-text tracking-tight mb-4">Send files,<br class="sm:hidden" /> <span class="text-accent"></span></h1>
        <p class="text-sm sm:text-base md:text-lg text-text-muted max-w-md mx-auto leading-relaxed">Fast, private, direct browser transfer. No uploads, no storage, no limits.</p>
      </div>

      <div class="border-2 border-border bg-surface p-6 sm:p-8 md:p-10 space-y-6">
        <div class="space-y-3">
          <label class="flex items-center gap-2.5 text-sm font-medium text-text-muted">
            <span class="text-accent">[+]</span>
            Select files
          </label>
          <input type="file" id="files" multiple class="block w-full text-sm text-text-muted file:mr-3 file:py-2 file:px-4 file:border-2 file:border-border file:text-sm file:font-mono file:bg-surface file:text-text file:cursor-pointer cursor-pointer" />
        </div>

        <button id="send" class="w-full inline-flex items-center justify-center gap-2.5 px-6 py-3.5 text-base font-bold text-bg bg-accent hover:bg-accent-hover border-2 border-border transition-colors">
          <span>START TRANSFER</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </button>

        <div id="progressArea" class="hidden space-y-2">
          <div class="w-full h-1.5 bg-surface border border-border">
            <div id="progressBar" class="h-full bg-accent transition-all duration-300" style="width: 0%"></div>
          </div>
          <button id="cancelBtn" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2 text-xs font-mono text-red border-2 border-border hover:bg-surface transition-colors">
            [CANCEL]
          </button>
        </div>

        <div class="space-y-3 pt-1">
          <div id="status" class="text-sm text-amber h-5 font-mono"></div>
          <div id="link" class="text-sm break-all flex flex-col sm:flex-row sm:items-center gap-2"></div>
        </div>
      </div>

      <div class="mt-8 flex items-center justify-center gap-6 text-text-dim">
        <div class="flex items-center gap-2">
          <span class="text-xs font-mono">[E2E]</span>
          <span class="text-xs">Encrypted</span>
        </div>
        <div class="w-1 h-1 bg-border"></div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-mono">[INF]</span>
          <span class="text-xs">No limits</span>
        </div>
        <div class="w-1 h-1 bg-border hidden sm:block"></div>
        <div class="hidden sm:flex items-center gap-2">
          <span class="text-xs font-mono">[NOW]</span>
          <span class="text-xs">Instant</span>
        </div>
      </div>
    </div>
  </div>

  <script>
    function setTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('nsend-theme', theme);
    }

    const buttons = document.querySelectorAll('[data-theme-btn]');
    function updateActiveButton() {
      const current = document.documentElement.getAttribute('data-theme');
      buttons.forEach(btn => {
        if (btn.getAttribute('data-theme-btn') === current) {
          btn.classList.add('bg-text', 'text-bg');
          btn.classList.remove('bg-bg', 'text-text');
        } else {
          btn.classList.remove('bg-text', 'text-bg');
          btn.classList.add('bg-bg', 'text-text');
        }
      });
    }
    buttons.forEach(btn => {
      btn.addEventListener('click', () => setTheme(btn.getAttribute('data-theme-btn')!));
    });
    updateActiveButton();

    import { initSender } from '../lib/sender';
    initSender();
  </script>
</body>
</html>
